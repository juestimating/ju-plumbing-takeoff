# Canonical public origin, no trailing slash. Used for canonicals, sitemap, OG tags and JSON-LD.
# Set it to the live domain (for example https://www.yourdomain.com) in the Vercel production environment only.
# A Vercel Production build refuses to run while it is blank, not https, or a placeholder.
NEXT_PUBLIC_SITE_URL=

# Set to "production" ONLY on the live domain. Anything else is served noindex, a Vercel production deploy included.
# Leave it blank locally and on previews. Do not copy this value into every Vercel environment.
NEXT_PUBLIC_SITE_ENV=

# Lead delivery: set RESEND_API_KEY + LEAD_FROM_EMAIL + LEAD_TO_EMAIL for email,
# and/or LEAD_WEBHOOK_URL to forward each lead as JSON (CRM, Zapier, Make, etc.).
# The indexable launch build (NEXT_PUBLIC_SITE_ENV=production) fails without at least one channel; before that the
# form asks visitors to call or email. Set both if you can: a lead counts as delivered when either one accepts it,
# so one provider outage then drops nothing.
RESEND_API_KEY=
LEAD_FROM_EMAIL=
LEAD_TO_EMAIL=info@juestimating.com
LEAD_WEBHOOK_URL=

# Optional: Google Analytics 4 measurement ID (Vercel Analytics works without any config)
NEXT_PUBLIC_GA_ID=

# Optional: public booking page for the "Book a consultation" CTA
NEXT_PUBLIC_BOOKING_URL=https://cal.com/juestimating/new-project-consultation

# Optional: set to 1 to send the Content-Security-Policy as Report-Only (violations show in the browser console,
# nothing is blocked). Use it while testing a new tag or embed, then remove it and redeploy. Production builds enforce the policy.
CSP_REPORT_ONLY=
