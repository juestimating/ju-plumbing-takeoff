  "description": "JU Plumbing Takeoff: plumbing takeoff and estimating services marketing site",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:content": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/lint-content.mjs",
    "typecheck": "tsc --noEmit",
